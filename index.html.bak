        {
          kode_sarang: "SRG-002",
          lokasi: "mangkai utara",
          jenis_penyu: "Penyu Hijau",
          kapan_pendaratan: "2026-08-05",
          jumlah_telur: 110,
          kapan_penetasan: "2026-09-04",
          status_adopsi: "Sudah Diadopsi",
          nama_adopter: "PT Lautan Indo",
        },
        {
          kode_sarang: "SRG-003",
          lokasi: "mangkai selatan",
          jenis_penyu: "Penyu Sisik",
          kapan_pendaratan: "2026-08-12",
          jumlah_telur: 85,
          kapan_penetasan: "2026-09-11",
          status_adopsi: "Sudah Diadopsi",
          nama_adopter: "Alif Pratama",
        },
        {
          kode_sarang: "SRG-004",
          lokasi: "mangkai utara",
          jenis_penyu: "Penyu Hijau",
          kapan_pendaratan: "2026-08-18",
          jumlah_telur: 105,
          kapan_penetasan: "2026-09-17",
          status_adopsi: "Belum Diadopsi",
          nama_adopter: "",
        },
        {
          kode_sarang: "SRG-005",
          lokasi: "mangkai selatan",
          jenis_penyu: "Penyu Sisik",
          kapan_pendaratan: "2026-08-24",
          jumlah_telur: 90,
          kapan_penetasan: "2026-09-23",
          status_adopsi: "Belum Diadopsi",
          nama_adopter: "",
        },
      ];

      const SEED_ADOPSI = [
        {
          kode_sarang: "SRG-001",
          jenis_penyu: "Penyu Sisik",
          jumlah_telur: 90,
          lokasi: "mangkai selatan",
          berapa_sarang: 1,
          nama_adopter: "Super Admin",
          progress: 30,
        },
        {
          kode_sarang: "SRG-002",
          jenis_penyu: "Penyu Hijau",
          jumlah_telur: 110,
          lokasi: "mangkai utara",
          berapa_sarang: 1,
          nama_adopter: "PT Lautan Indo",
          progress: 60,
        },
        {
          kode_sarang: "SRG-003",
          jenis_penyu: "Penyu Sisik",
          jumlah_telur: 85,
          lokasi: "mangkai selatan",
          berapa_sarang: 1,
          nama_adopter: "Alif Pratama",
          progress: 100,
        },
      ];

      // Initialize LocalStorage with Super Admin as default logged in user
      if (!localStorage.getItem("bts_users"))
        localStorage.setItem("bts_users", JSON.stringify(SEED_USERS));
      if (!localStorage.getItem("bts_pendaratan"))
        localStorage.setItem("bts_pendaratan", JSON.stringify(SEED_PENDARATAN));
      if (!localStorage.getItem("bts_adopsi"))
        localStorage.setItem("bts_adopsi", JSON.stringify(SEED_ADOPSI));

      // Default current user is the Super Admin created by developer!
      let currentUser =
        JSON.parse(localStorage.getItem("bts_current_user")) || null;

      let selectedCategory = "super_admin";

      document.addEventListener("DOMContentLoaded", async () => {
        lucide.createIcons();
        initNav();
        initMap();
        initChart();
        syncUI();
        await loadPendaratanFromAPI();
      });

      // --- Navigation ---
      function initNav() {
        document.querySelectorAll(".nav-link").forEach((link) => {
          link.addEventListener("click", (e) => {
            e.preventDefault();
            const pageId = link.getAttribute("data-page");
            if (pageId) goToPage(pageId);
          });
        });
      }

      function goToPage(pageId) {
        document
          .querySelectorAll(".page-view")
          .forEach((v) => v.classList.remove("active"));
        document
          .querySelectorAll(".nav-link")
          .forEach((l) => l.classList.remove("active"));

        const target = document.getElementById(pageId);
        if (target) target.classList.add("active");

        const navLink = document.querySelector(
          `.nav-link[data-page="${pageId}"]`,
        );
        if (navLink) navLink.classList.add("active");

        window.scrollTo({ top: 0, behavior: "smooth" });

        if (pageId === "page-beranda" && window.homeMapInstance) {
          setTimeout(() => window.homeMapInstance.invalidateSize(), 200);
        }
      }

      // --- Profile & Authentication System ---
      function syncUI() {
        renderUserProfile();
        renderPendaratan();
        renderAdopsi();
        renderUsers();
        populateAdopsiSarangSelect();
      }

      function renderUserProfile() {
        const avatar = document.getElementById("topAvatar");
        const name = document.getElementById("topUserName");
        const role = document.getElementById("topUserRole");
        const menuAdmin = document.getElementById("menuKelola");
        const sideTag = document.getElementById("sideRoleTag");
        const sideDesc = document.getElementById("sideRoleDesc");

        if (currentUser) {
          const initials = (currentUser.nama || "User")
            .split(" ")
            .map((x) => x[0])
            .join("")
            .substring(0, 2)
            .toUpperCase();
          avatar.textContent = initials;
          name.textContent = currentUser.nama;
          role.textContent = formatRole(currentUser.role);
          menuAdmin.style.display = ["admin", "super_admin"].includes(
            currentUser.role,
          )
            ? "block"
            : "none";
          sideTag.textContent = formatRole(currentUser.role);
          sideDesc.textContent =
            currentUser.role === "super_admin"
              ? "Akses penuh ke semua data & formulir."
              : currentUser.role === "admin"
                ? "Kelola data dan konten platform."
                : currentUser.role === "pendata"
                  ? "Kelola data pendaratan penyu."
                  : currentUser.role === "mitra"
                    ? "Kelola berita milik sendiri."
                    : "Akses sebagai pengguna biasa.";
        } else {
          avatar.textContent = "?";
          name.textContent = "Belum Login";
          role.textContent = "PENGGUNA";
          menuAdmin.style.display = "none";
          sideTag.textContent = "PENGGUNA";
          sideDesc.textContent = "Silakan login untuk mengakses fitur akun.";
        }
        renderBerita();
        const btnTambahP = document.querySelector(
          "button[onclick=\"openModal('modalTambahPendaratan')\"]",
        );
        const btnImpor = document.getElementById("btnImporSample");
        if (btnTambahP)
          btnTambahP.style.display = canManageAll() ? "inline-flex" : "none";
        if (btnImpor)
          btnImpor.style.display = canManageAll() ? "inline-flex" : "none";
      }

      function formatRole(role) {
        return (role || "masyarakat")
          .replace("_", " ")
          .replace("kemitraan", "mitra")
          .toUpperCase();
      }

      function openProfileMenu() {
        if (!currentUser) {
          openModal("modalLogin");
          return;
        }
        document.getElementById("profileModalName").textContent =
          currentUser.nama;
        document.getElementById("profileModalEmail").textContent =
          currentUser.email;
        document.getElementById("profileModalRole").textContent = formatRole(
          currentUser.role,
        );
        openModal("modalProfileMenu");
      }

      function logoutUser() {
        currentUser = null;
        localStorage.removeItem("bts_current_user");
        closeModal("modalProfileMenu");
        renderUserProfile();
        showToast("Anda berhasil logout.");
      }

      function setCategoryChoice(cat) {
        selectedCategory = cat;
        document
          .getElementById("btnRoleMasyarakat")
          .classList.toggle("active", cat === "masyarakat");
        document
          .getElementById("btnRoleMitra")
          .classList.toggle("active", cat === "mitra");
        document
          .getElementById("btnRoleSuperAdmin")
          .classList.toggle("active", cat === "super_admin");
      }

      function openAuthModal(type) {
        closeModal("modalKategoriAkun");
        if (type === "register" && selectedCategory !== "masyarakat") {
          alert(
            "Pendaftaran mandiri hanya untuk Masyarakat. Akun Pendata, Mitra, Admin, dan Super Admin dibuat oleh Admin/Super Admin.",
          );
          return;
        }
        if (type === "login") {
          document.getElementById("loginEmail").value = "";
          document.getElementById("loginPassword").value = "";
          openModal("modalLogin");
        } else {
          document.getElementById("formRegister").reset();
          openModal("modalRegister");
        }
      }

      function loginAsDeveloperSuperAdmin() {
        const users =
          JSON.parse(localStorage.getItem("bts_users")) || SEED_USERS;
        const superAdmin =
          users.find((u) => u.role === "super_admin") || SEED_USERS[0];
        currentUser = superAdmin;
        localStorage.setItem("bts_current_user", JSON.stringify(superAdmin));
        closeModal("modalKategoriAkun");
        renderUserProfile();
        showToast("Berhasil masuk sebagai Super Admin.");
      }

      document.getElementById("formLogin").addEventListener("submit", (e) => {
        e.preventDefault();
        const email = document
          .getElementById("loginEmail")
          .value.trim()
          .toLowerCase();
        const pass = document.getElementById("loginPassword").value;
        const users =
          JSON.parse(localStorage.getItem("bts_users")) || SEED_USERS;
        const user = users.find((u) => u.email.toLowerCase() === email);

        if (!user) {
          alert(
            "Akun belum terdaftar. Untuk Mitra/Pendata/Admin/Super Admin, akun harus dibuat oleh Admin.",
          );
          return;
        }

        // Prototype: password may not exist in legacy seed/localStorage data.
        // If a password exists, validate it.
        if (user.password && user.password !== pass) {
          alert("Email atau kata sandi salah.");
          return;
        }

        currentUser = user;
        localStorage.setItem("bts_current_user", JSON.stringify(user));
        closeModal("modalLogin");
        renderUserProfile();
        showToast(
          `Login berhasil sebagai ${user.nama} (${formatRole(user.role)}).`,
        );
      });

      document
        .getElementById("formRegister")
        .addEventListener("submit", (e) => {
          e.preventDefault();
          const nama = document.getElementById("regNama").value.trim();
          const email = document.getElementById("regEmail").value.trim();
          const pass = document.getElementById("regPass").value;
          const passC = document.getElementById("regPassConfirm").value;

          if (selectedCategory !== "masyarakat") {
            alert("Hanya Masyarakat yang dapat mendaftar sendiri.");
            return;
          }
          if (pass !== passC) {
            alert("Konfirmasi kata sandi tidak cocok!");
            return;
          }

          const users =
            JSON.parse(localStorage.getItem("bts_users")) || SEED_USERS;
          if (
            users.some((u) => u.email.toLowerCase() === email.toLowerCase())
          ) {
            alert("Email sudah terdaftar.");
            return;
          }

          const newUser = {
            id: Date.now(),
            nama,
            email,
            password: pass,
            role: "masyarakat",
            created_at: new Date().toISOString().split("T")[0],
          };

          users.push(newUser);
          localStorage.setItem("bts_users", JSON.stringify(users));
          currentUser = newUser;
          localStorage.setItem("bts_current_user", JSON.stringify(newUser));

          closeModal("modalRegister");
          renderUserProfile();
          showToast(`Akun ${nama} berhasil didaftarkan sebagai MASYARAKAT.`);
        });

      // --- Interactive Map ---
      function initMap() {
        const anambas = [3.095, 105.588];
        window.homeMapInstance = L.map("mapHome", {
          zoomControl: true,
          scrollWheelZoom: false,
          doubleClickZoom: false,
          touchZoom: false,
          boxZoom: false,
        }).setView(anambas, 11);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          attribution: "&copy; OpenStreetMap",
        }).addTo(window.homeMapInstance);

        const pins = [
          {
            pos: [3.082, 105.585],
            title: "Pantai Mangkai Selatan",
            code: "MS-001",
            info: "Penyu Sisik & Hijau (265 Telur)",
          },
          {
            pos: [3.108, 105.592],
            title: "Pantai Mangkai Utara",
            code: "MU-207",
            info: "Penyu Hijau (215 Telur)",
          },
        ];

        pins.forEach((p) => {
          const marker = L.marker(p.pos).addTo(window.homeMapInstance);
          marker.bindPopup(`
          <div style="font-family:'Plus Jakarta Sans',sans-serif; min-width:150px; color:#121524;">
            <strong style="color:#0288d1; font-size:0.9rem;">${p.title}</strong><br>
            <span style="font-size:0.75rem;">Kode: <b>${p.code}</b></span><br>
            <span style="font-size:0.75rem; color:#d97706;">${p.info}</span>
          </div>
        `);
        });
      }

      // --- Interactive Charts ---
      function initChart() {
        const ctxBar = document.getElementById("chartTimeSeries");
        if (ctxBar) {
          new Chart(ctxBar, {
            type: "bar",
            data: {
              labels: ["2021", "2022", "2023", "2024", "2025", "2026"],
              datasets: [
                {
                  label: "Mangkai Selatan",
                  data: [35, 42, 38, 45, 52, 60],
                  backgroundColor: "#ffce31",
                  borderRadius: 6,
                },
                {
                  label: "Mangkai Utara",
                  data: [28, 34, 40, 48, 55, 65],
                  backgroundColor: "#29b6f6",
                  borderRadius: 6,
                },
              ],
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { labels: { color: "#ffffff", font: { size: 10 } } },
              },
              scales: {
                x: { ticks: { color: "#a4b3cf" }, grid: { display: false } },
                y: {
                  ticks: { color: "#a4b3cf" },
                  grid: { color: "rgba(255,255,255,0.06)" },
                },
              },
            },
          });
        }

        const ctxDonut = document.getElementById("chartDonut");
        if (ctxDonut) {
          new Chart(ctxDonut, {
            type: "doughnut",
            data: {
              labels: [
                "Penyu Sisik (56%)",
                "Penyu Hijau (37%)",
                "Lainnya (7%)",
              ],
              datasets: [
                {
                  data: [56, 37, 7],
                  backgroundColor: ["#29b6f6", "#4ecca3", "#ffce31"],
                  borderWidth: 0,
                },
              ],
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  position: "bottom",
                  labels: { color: "#ffffff", font: { size: 10 } },
                },
              },
            },
          });
        }
      }

      // --- Pendaratan Table & Logic ---
      function canManageAll() {
        return (
          currentUser && ["admin", "super_admin"].includes(currentUser.role)
        );
      }

      function canDeletePendaratan() {
        return (
          currentUser &&
          ["admin", "super_admin", "pendata"].includes(currentUser.role)
        );
      }
async function loadPendaratanFromAPI() {
  try {
    const [pendaratanRes, adopsiRes] = await Promise.all([
      fetch("https://blue-turtle-squad.marissacitra5.workers.dev/api/pendaratan"),
      fetch("https://blue-turtle-squad.marissacitra5.workers.dev/api/adopsi")
    ]);

    const pendaratanResult = await pendaratanRes.json();
    const adopsiResult = await adopsiRes.json();

    if (!pendaratanResult.success) {
      throw new Error("Gagal mengambil data pendaratan");
    }

    if (!adopsiResult.success) {
      throw new Error("Gagal mengambil data adopsi");
    }

    dataPendaratan = pendaratanResult.data || [];
    dataAdopsi = adopsiResult.data || [];

    renderPendaratan();
    populateAdopsiSarangSelect();

  } catch (error) {
    console.error("Gagal mengambil data:", error);
    alert("Gagal mengambil data pendaratan dari server.");
  }
}

function renderPendaratan() {
  const list = dataPendaratan;        const search = document
          .getElementById("searchKode")
          .value.toLowerCase();
        const fLoc = document.getElementById("filterLoc").value.toLowerCase();
        const fSpec = document.getElementById("filterSpesies").value;

        const filtered = list.filter((p) => {
          const mCode = p.kode_sarang.toLowerCase().includes(search);
          const mLoc = !fLoc || p.lokasi.toLowerCase() === fLoc;
          const mSpec = !fSpec || p.jenis_penyu === fSpec;
          return mCode && mLoc && mSpec;
        });

        const tbody = document.getElementById("tbodyPendaratan");
        tbody.innerHTML = "";

        if (filtered.length === 0) {
          tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:18px; color:var(--text-muted);">Tidak ada data pendaratan yang sesuai.</td></tr>`;
          return;
        }

        filtered.forEach((p) => {
          const tr = document.createElement("tr");
          const badge = p.jenis_penyu.includes("Sisik")
            ? "badge-sisik"
            : "badge-hijau";
const adopsi = dataAdopsi.find(
  (a) => a.kode_sarang === p.kode_sarang
);

const adopted = !!adopsi;
const namaAdopter = adopsi ? adopsi.nama_adopter : "";

const statusHtml = adopted
            ? `<span class="status-adopsi sudah">Sudah Diadopsi<small>${namaAdopter}</small></span>`
            : `<span class="status-adopsi belum">Belum Diadopsi</span>`;

          let actionHtml = statusHtml;
          if (canManageAll()) {
            actionHtml += `<div class="row-actions" style="margin-top:6px;">
            <button class="btn btn-outline" style="padding:4px 9px;font-size:.7rem;" onclick="editPendaratan('${p.kode_sarang}')">Edit</button>
            <button class="btn btn-danger" style="padding:4px 9px;font-size:.7rem;" onclick="deletePendaratan('${p.kode_sarang}')">Hapus</button>
          </div>`;
          } else if (currentUser && currentUser.role === "pendata") {
            actionHtml += `<div class="row-actions" style="margin-top:6px;">
            <button class="btn btn-danger" style="padding:4px 9px;font-size:.7rem;" onclick="deletePendaratan('${p.kode_sarang}')">Hapus</button>
          </div>`;
          }

          tr.innerHTML = `
          <td><strong>${p.kode_sarang}</strong></td>
          <td style="text-transform:capitalize;">${p.lokasi}</td>
          <td><span class="badge-pill ${badge}">${p.jenis_penyu}</span></td>
          <td>${p.kapan_pendaratan}</td>
          <td><strong>${p.jumlah_telur} butir</strong></td>
          <td>${p.kapan_penetasan}</td>
          <td>${actionHtml}</td>
        `;
          tbody.appendChild(tr);
        });

        const totalTelur = list.reduce(
          (a, c) => a + Number(c.jumlah_telur || 0),
          0,
        );
        document.getElementById("statTelur").textContent = totalTelur;
        document.getElementById("statLokasi").textContent = list.length;
      }

      function deletePendaratan(kode) {
        if (!canDeletePendaratan()) {
          alert("Anda tidak memiliki izin menghapus data pendaratan.");
          return;
        }
        if (!confirm(`Hapus data sarang ${kode}?`)) return;
        let list =
          JSON.parse(localStorage.getItem("bts_pendaratan")) || SEED_PENDARATAN;
        list = list.filter((p) => p.kode_sarang !== kode);
        localStorage.setItem("bts_pendaratan", JSON.stringify(list));
        renderPendaratan();
        populateAdopsiSarangSelect();
        showToast(`Data ${kode} berhasil dihapus.`);
      }

      function editPendaratan(kode) {
        if (!canManageAll()) {
          alert(
            "Hanya Admin dan Super Admin yang dapat mengedit data pendaratan.",
          );
          return;
        }
        const list =
          JSON.parse(localStorage.getItem("bts_pendaratan")) || SEED_PENDARATAN;
        const p = list.find((x) => x.kode_sarang === kode);
        if (!p) return;
        document.getElementById("editKodeLama").value = p.kode_sarang;
        document.getElementById("editKodeSarang").value = p.kode_sarang;
        document.getElementById("editJenisPenyu").value = p.jenis_penyu;
        document.getElementById("editKapanPendaratan").value =
          p.kapan_pendaratan;
        document.getElementById("editLokasi").value = p.lokasi;
        document.getElementById("editJumlahTelur").value = p.jumlah_telur;
        document.getElementById("editKapanPenetasan").value = p.kapan_penetasan;
        openModal("modalEditPendaratan");
      }

      document
        .getElementById("formEditPendaratan")
        .addEventListener("submit", (e) => {
          e.preventDefault();
          if (!canManageAll()) return;
          const oldCode = document.getElementById("editKodeLama").value;
          const newCode = document
            .getElementById("editKodeSarang")
            .value.trim()
            .toUpperCase();
          let list =
            JSON.parse(localStorage.getItem("bts_pendaratan")) ||
            SEED_PENDARATAN;
          if (
            newCode !== oldCode &&
            list.some((p) => p.kode_sarang === newCode)
          ) {
            alert("Kode sarang sudah terdaftar!");
            return;
          }
          const p = list.find((x) => x.kode_sarang === oldCode);
          if (!p) return;
          p.kode_sarang = newCode;
          p.jenis_penyu = document.getElementById("editJenisPenyu").value;
          p.kapan_pendaratan = document.getElementById(
            "editKapanPendaratan",
          ).value;
          p.lokasi = document.getElementById("editLokasi").value;
          p.jumlah_telur = parseInt(
            document.getElementById("editJumlahTelur").value,
          );
          p.kapan_penetasan =
            document.getElementById("editKapanPenetasan").value;
          localStorage.setItem("bts_pendaratan", JSON.stringify(list));
          renderPendaratan();
          populateAdopsiSarangSelect();
          closeModal("modalEditPendaratan");
          showToast(`Data ${newCode} berhasil diperbarui.`);
        });

      document
        .getElementById("searchKode")
        .addEventListener("input", renderPendaratan);
      document
        .getElementById("filterLoc")
        .addEventListener("change", renderPendaratan);
      document
        .getElementById("filterSpesies")
        .addEventListener("change", renderPendaratan);

      document
        .getElementById("formTambahPendaratan")
        .addEventListener("submit", (e) => {
          e.preventDefault();
          if (!canManageAll()) {
            alert(
              "Hanya Admin dan Super Admin yang dapat menambah data pendaratan.",
            );
            return;
          }
          const kode = document
            .getElementById("inpKodeSarang")
            .value.trim()
            .toUpperCase();
          const jenis = document.getElementById("inpJenisPenyu").value;
          const tglDarat = document.getElementById("inpKapanPendaratan").value;
          const lokasi = document.getElementById("inpLokasi").value;
          const telur = parseInt(
            document.getElementById("inpJumlahTelur").value,
          );
          const tglTetas = document.getElementById("inpKapanPenetasan").value;

          const pList =
            JSON.parse(localStorage.getItem("bts_pendaratan")) ||
            SEED_PENDARATAN;
          if (pList.some((p) => p.kode_sarang === kode)) {
            alert("Kode sarang sudah terdaftar!");
            return;
          }

          const item = {
            kode_sarang: kode,
            jenis_penyu: jenis,
            kapan_pendaratan: tglDarat,
            lokasi: lokasi,
            jumlah_telur: telur,
            kapan_penetasan: tglTetas,
            status_adopsi: "Belum Diadopsi",
            nama_adopter: "",
          };

          pList.unshift(item);
          localStorage.setItem("bts_pendaratan", JSON.stringify(pList));

          renderPendaratan();
          populateAdopsiSarangSelect();
          closeModal("modalTambahPendaratan");
          e.target.reset();
          showToast(`Data Sarang ${kode} berhasil disimpan!`);
        });

      document
        .getElementById("btnImporSample")
        .addEventListener("click", () => {
          if (!canManageAll()) {
            alert(
              "Hanya Admin dan Super Admin yang dapat mengimpor data pendaratan.",
            );
            return;
          }
          const pList =
            JSON.parse(localStorage.getItem("bts_pendaratan")) ||
            SEED_PENDARATAN;
          const num = pList.length + 1;
          const newItem = {
            kode_sarang: `SRG-00${num}`,
            lokasi: num % 2 === 0 ? "mangkai utara" : "mangkai selatan",
            jenis_penyu: num % 2 === 0 ? "Penyu Hijau" : "Penyu Sisik",
            kapan_pendaratan: "2026-08-28",
            jumlah_telur: 95,
            kapan_penetasan: "2026-09-27",
            status_adopsi: "Belum Diadopsi",
            nama_adopter: "",
          };
          pList.unshift(newItem);
          localStorage.setItem("bts_pendaratan", JSON.stringify(pList));
          renderPendaratan();
          populateAdopsiSarangSelect();
          showToast(`Sarang baru ${newItem.kode_sarang} berhasil diimpor!`);
        });

      // --- Program Adopsi Logic ---
      function populateAdopsiSarangSelect() {
        const pList =
          JSON.parse(localStorage.getItem("bts_pendaratan")) || SEED_PENDARATAN;
        const sel = document.getElementById("inpAdopsiIdSarang");
        sel.innerHTML = "";
        pList
          .filter(
            (p) => p.status_adopsi !== "Sudah Diadopsi" && !p.nama_adopter,
          )
          .forEach((p) => {
            const opt = document.createElement("option");
            opt.value = p.kode_sarang;
            opt.textContent = `${p.kode_sarang} - ${p.jenis_penyu} (${p.lokasi}, ${p.jumlah_telur} telur)`;
            sel.appendChild(opt);
          });
      }

      function openAdopsiModal(spesies, defaultCode) {
        if (!currentUser) {
          alert("Silakan login terlebih dahulu untuk melakukan adopsi.");
          return;
        }
        if (currentUser.role !== "masyarakat") {
          alert("Fitur adopsi ditujukan untuk pengguna Masyarakat.");
          return;
        }
        if (currentUser) {
          document.getElementById("inpAdopsiNamaAkun").value = currentUser.nama;
        } else {
          document.getElementById("inpAdopsiNamaAkun").value = "Super Admin";
        }

        if (defaultCode) {
          document.getElementById("inpAdopsiIdSarang").value = defaultCode;
        }
        openModal("modalAdopsiForm");
      }

      document
        .getElementById("formAdopsiKirim")
        .addEventListener("submit", (e) => {
          e.preventDefault();
          const nama = document
            .getElementById("inpAdopsiNamaAkun")
            .value.trim();
          const kodeSarang = document.getElementById("inpAdopsiIdSarang").value;
          const berapa = parseInt(
            document.getElementById("inpAdopsiBerapaSarang").value,
          );

          const pList =
            JSON.parse(localStorage.getItem("bts_pendaratan")) ||
            SEED_PENDARATAN;
          const target = pList.find((p) => p.kode_sarang === kodeSarang) || {
            jenis_penyu: "Penyu Hijau",
            lokasi: "mangkai selatan",
            jumlah_telur: 90,
          };
          if (
            target.status_adopsi === "Sudah Diadopsi" ||
            target.nama_adopter
          ) {
            alert(
              `Sarang ${kodeSarang} sudah diadopsi oleh ${target.nama_adopter || "adopter lain"}.`,
            );
            return;
          }

          const adopsiList =
            JSON.parse(localStorage.getItem("bts_adopsi")) || SEED_ADOPSI;
          const newAdopsi = {
            kode_sarang: kodeSarang,
            jenis_penyu: target.jenis_penyu,
            jumlah_telur: target.jumlah_telur,
            lokasi: target.lokasi,
            berapa_sarang: berapa,
            nama_adopter: nama,
            progress: 30,
          };

          adopsiList.unshift(newAdopsi);
          localStorage.setItem("bts_adopsi", JSON.stringify(adopsiList));

          target.status_adopsi = "Sudah Diadopsi";
          target.nama_adopter = nama;
          localStorage.setItem("bts_pendaratan", JSON.stringify(pList));

          renderPendaratan();
          renderAdopsi();
          closeModal("modalAdopsiForm");
          showToast("Formulir adopsi berhasil diajukan!");
          openTahapanDetail(kodeSarang);
        });

      function renderAdopsi() {
        const list =
          JSON.parse(localStorage.getItem("bts_adopsi")) || SEED_ADOPSI;
        const tbody = document.getElementById("tbodyAdopsi");
        tbody.innerHTML = "";

        list.forEach((a) => {
          const tr = document.createElement("tr");
          tr.innerHTML = `
          <td><strong>${a.kode_sarang}</strong></td>
          <td>${a.jenis_penyu}</td>
          <td style="text-transform: capitalize;">${a.lokasi}</td>
          <td>${a.jumlah_telur} butir</td>
          <td><b>${a.nama_adopter}</b></td>
          <td style="width: 150px;">
            <div style="display:flex; align-items:center; gap:8px;">
              <div class="prog-track"><div class="prog-fill" style="width:${a.progress}%;"></div></div>
              <span style="font-size:0.75rem; font-weight:700;">${a.progress}%</span>
            </div>
          </td>
          <td>
            <button class="btn btn-outline" style="padding:4px 12px; font-size:0.75rem;" onclick="openTahapanDetail('${a.kode_sarang}')">
              Tahapan
            </button>
          </td>
        `;
          tbody.appendChild(tr);
        });

        document.getElementById("statAdopter").textContent =
          list.length * 28 + 2;
      }

      function openTahapanDetail(kode) {
        closeModal("modalAdopsiForm");
        openModal("modalTahapanDetail");
      }

      // --- Users Table (Super Admin) ---
      function renderUsers() {
        const users =
          JSON.parse(localStorage.getItem("bts_users")) || SEED_USERS;
        const tbody = document.getElementById("tbodyUsers");
        tbody.innerHTML = "";

        users.forEach((u) => {
          const tr = document.createElement("tr");
          tr.innerHTML = `
          <td>${u.id}</td>
          <td><b>${u.nama}</b></td>
          <td>${u.email}</td>
          <td><span class="badge-pill badge-sisik">${u.role.replace("_", " ").toUpperCase()}</span></td>
          <td>${u.created_at || "2026-08-01"}</td>
          <td>
            ${u.role !== "super_admin" ? `<button class="btn btn-danger" style="padding:4px 10px; font-size:0.72rem;" onclick="deleteUserRow(${u.id})">Hapus</button>` : '<span style="color:var(--gold); font-size:0.72rem; font-weight:700;">Utama</span>'}
          </td>
        `;
          tbody.appendChild(tr);
        });
      }

      function submitNewUser() {
        const nama = document.getElementById("uNama").value.trim();
        const email = document.getElementById("uEmail").value.trim();
        const role = document.getElementById("uRole").value;

        if (
          !currentUser ||
          !["admin", "super_admin"].includes(currentUser.role)
        ) {
          alert("Anda tidak memiliki izin mengelola pengguna.");
          return;
        }
        if (currentUser.role === "admin" && role === "super_admin") {
          alert("Admin tidak dapat membuat Super Admin.");
          return;
        }

        const users =
          JSON.parse(localStorage.getItem("bts_users")) || SEED_USERS;
        const newUser = {
          id: Date.now(),
          nama: nama,
          email: email,
          role: role,
          password: document.getElementById("uPass").value,
          created_at: new Date().toISOString().split("T")[0],
        };

        users.push(newUser);
        localStorage.setItem("bts_users", JSON.stringify(users));
        renderUsers();
        closeModal("modalTambahUser");
        showToast(`Pengguna ${nama} berhasil dibuat!`);
      }

      function deleteUserRow(id) {
        if (
          !currentUser ||
          !["admin", "super_admin"].includes(currentUser.role)
        ) {
          alert("Anda tidak memiliki izin menghapus pengguna.");
          return;
        }
        if (currentUser.role === "admin") {
          const usersNow =
            JSON.parse(localStorage.getItem("bts_users")) || SEED_USERS;
          const target = usersNow.find((u) => u.id === id);
          if (target && target.role === "super_admin") {
            alert("Admin tidak dapat menghapus Super Admin.");
            return;
          }
        }
        if (confirm("Hapus pengguna ini?")) {
          let users =
            JSON.parse(localStorage.getItem("bts_users")) || SEED_USERS;
          users = users.filter((u) => u.id !== id);
          localStorage.setItem("bts_users", JSON.stringify(users));
          renderUsers();
          showToast("Pengguna telah dihapus.");
        }
      }

      // --- Berita Mitra ---
      const SEED_BERITA = [
        {
          id: 1,
          judul: "Kegiatan Monitoring Sarang Penyu",
          isi: "Monitoring rutin lokasi pendaratan penyu.",
          owner_id: 4,
          owner_name: "PT Lautan Indo Prima",
          tanggal: "2026-08-20",
        },
        {
          id: 2,
          judul: "Kolaborasi Konservasi Pesisir",
          isi: "Kegiatan kolaborasi bersama masyarakat pesisir.",
          owner_id: 2,
          owner_name: "Budi Santoso",
          tanggal: "2026-08-25",
        },
      ];
      if (!localStorage.getItem("bts_berita"))
        localStorage.setItem("bts_berita", JSON.stringify(SEED_BERITA));

      function canCreateBerita() {
        return (
          currentUser &&
          ["admin", "super_admin", "mitra"].includes(currentUser.role)
        );
      }

      function canDeleteBerita(item) {
        if (!currentUser) return false;
        if (["admin", "super_admin"].includes(currentUser.role)) return true;
        return (
          currentUser.role === "mitra" &&
          Number(item.owner_id) === Number(currentUser.id)
        );
      }

      function renderBerita() {
        const tbody = document.getElementById("tbodyBerita");
        const btn = document.getElementById("btnTambahBerita");
        if (!tbody) return;
        const list =
          JSON.parse(localStorage.getItem("bts_berita")) || SEED_BERITA;
        if (btn) btn.style.display = canCreateBerita() ? "inline-flex" : "none";

        tbody.innerHTML = list.length
          ? list
              .map((b) => {
                const deleteBtn = canDeleteBerita(b)
                  ? `<button class="btn btn-danger" style="padding:4px 9px;font-size:.7rem;" onclick="deleteBerita(${b.id})">Hapus</button>`
                  : "";
                const editBtn =
                  currentUser &&
                  ["admin", "super_admin"].includes(currentUser.role)
                    ? `<button class="btn btn-outline" style="padding:4px 9px;font-size:.7rem;" onclick="editBerita(${b.id})">Edit</button>`
                    : "";
                return `<tr>
          <td><strong>${b.judul}</strong><div style="font-size:.7rem;color:var(--text-muted);margin-top:3px;">${b.isi}</div></td>
          <td>${b.owner_name || "-"}</td>
          <td>${b.tanggal || "-"}</td>
          <td><div class="row-actions">${editBtn}${deleteBtn}</div></td>
        </tr>`;
              })
              .join("")
          : `<tr><td colspan="4" style="text-align:center;color:var(--text-muted);padding:18px;">Belum ada berita.</td></tr>`;
      }

      function openBeritaForm() {
        if (!canCreateBerita()) {
          alert(
            "Hanya Mitra yang terdaftar, Admin, atau Super Admin yang dapat menambah berita.",
          );
          return;
        }
        document.getElementById("formBerita").reset();
        document.getElementById("beritaId").value = "";
        document.getElementById("judulModalBerita").textContent =
          "TAMBAH BERITA";
        openModal("modalBeritaForm");
      }

      function editBerita(id) {
        if (
          !currentUser ||
          !["admin", "super_admin"].includes(currentUser.role)
        ) {
          alert(
            "Mitra hanya dapat menghapus berita miliknya, bukan mengedit berita.",
          );
          return;
        }
        const list = JSON.parse(localStorage.getItem("bts_berita")) || [];
        const b = list.find((x) => x.id === id);
        if (!b) return;
        document.getElementById("beritaId").value = b.id;
        document.getElementById("beritaJudul").value = b.judul;
        document.getElementById("beritaIsi").value = b.isi;
        document.getElementById("judulModalBerita").textContent = "EDIT BERITA";
        openModal("modalBeritaForm");
      }

      document.getElementById("formBerita").addEventListener("submit", (e) => {
        e.preventDefault();
        if (!canCreateBerita()) return;
        let list = JSON.parse(localStorage.getItem("bts_berita")) || [];
        const id = document.getElementById("beritaId").value;
        const judul = document.getElementById("beritaJudul").value.trim();
        const isi = document.getElementById("beritaIsi").value.trim();

        if (id && ["admin", "super_admin"].includes(currentUser.role)) {
          const item = list.find((x) => x.id === Number(id));
          if (item) {
            item.judul = judul;
            item.isi = isi;
          }
        } else {
          list.unshift({
            id: Date.now(),
            judul,
            isi,
            owner_id: currentUser.id,
            owner_name: currentUser.nama,
            tanggal: new Date().toISOString().split("T")[0],
          });
        }
        localStorage.setItem("bts_berita", JSON.stringify(list));
        closeModal("modalBeritaForm");
        renderBerita();
        showToast("Berita berhasil disimpan.");
      });

      function deleteBerita(id) {
        const list = JSON.parse(localStorage.getItem("bts_berita")) || [];
        const item = list.find((x) => x.id === id);
        if (!item || !canDeleteBerita(item)) {
          alert("Mitra hanya dapat menghapus berita miliknya sendiri.");
          return;
        }
        if (!confirm(`Hapus berita "${item.judul}"?`)) return;
        localStorage.setItem(
          "bts_berita",
          JSON.stringify(list.filter((x) => x.id !== id)),
        );
        renderBerita();
        showToast("Berita berhasil dihapus.");
      }

      // --- Tour Booking, Mitra, Invest ---
      function openBookingTour(pkgName) {
        document.getElementById("tourName").value = pkgName;
        if (currentUser)
          document.getElementById("tourCust").value = currentUser.nama;
        openModal("modalTour");
      }

      function submitTour() {
        closeModal("modalTour");
        showToast("Reservasi guide wisata berhasil dikirimkan!");
      }

      function submitMitraForm() {
        const org = document.getElementById("mitraNama").value.trim();
        closeModal("modalMitra");
        showToast(`Kemitraan untuk ${org} berhasil diajukan!`);
      }

      function openInvestModal() {
        const nominal = prompt(
          "Masukkan nominal pengajuan investasi / donasi (Rp):",
          "5.000.000",
        );
        if (nominal) {
          showToast("Terima kasih! Proposal investasi telah tercatat.");
        }
      }

      function switchReportTab(btn, id) {
        document
          .querySelectorAll(".report-box")
          .forEach((b) => (b.style.display = "none"));
        btn.parentElement
          .querySelectorAll(".tab-btn")
          .forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        document.getElementById(id).style.display = "block";
      }

      // --- Modal Helpers ---
      function openModal(id) {
        const el = document.getElementById(id);
        if (el) el.classList.add("open");
      }

      function closeModal(id) {
        const el = document.getElementById(id);
        if (el) el.classList.remove("open");
      }

      document.querySelectorAll(".modal-overlay").forEach((overlay) => {
        overlay.addEventListener("click", (e) => {
          if (e.target === overlay) overlay.classList.remove("open");
        });
      });

      function showToast(msg) {
        const t = document.getElementById("toastAlert");
        document.getElementById("toastText").textContent = msg;
        t.classList.add("show");
        setTimeout(() => t.classList.remove("show"), 3500);
      }
    </script>
  </body>
</html>
 