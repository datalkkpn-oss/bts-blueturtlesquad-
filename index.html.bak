    <!-- ========================================================
       MODAL 1: TAMBAH PENDARATAN PENYU (Page 1 in Design)
       ======================================================== -->
    <div class="modal-overlay" id="modalTambahPendaratan">
      <div class="modal-box">
        <div class="modal-head">
          <button
            class="btn-close-modal"
            onclick="closeModal('modalTambahPendaratan')"
          >
            &times;
          </button>
          <h2>TAMBAH PENDARATAN PENYU</h2>
        </div>

        <form id="formTambahPendaratan">
          <div class="form-row">
            <label>Kode sarang</label>
            <input
              type="text"
              id="inpKodeSarang"
              class="pill-form-input"
              placeholder="masukkan kode sarang"
              required
            />
          </div>

          <div class="form-row">
            <label>Jenis Penyu</label>
            <select id="inpJenisPenyu" class="pill-form-input" required>
              <option value="Penyu Sisik">Penyu Sisik</option>
              <option value="Penyu Hijau">Penyu Hijau</option>
            </select>
          </div>

          <div class="form-row">
            <label>Kapan Pendaratan</label>
